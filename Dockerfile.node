# Node Agent Docker 镜像。
#
# 构建：
#   cd node-agent
#   docker build -f Dockerfile.node -t nodefetch/node-agent:mvp .
#
# 运行建议：用 docker compose up（见 docker-compose.yml），自动配 aria2 + 卷。
FROM python:3.12-slim-bookworm AS base

WORKDIR /app

# aria2 依赖（避免在 pip 之后才装，加快 rebuild）
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends aria2 ca-certificates curl tini; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# --- Python deps ---
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r /app/requirements.txt

# --- 源码 ---
COPY . /app/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 非 root 运行（安全默认）；aria2 session 文件写入也用这个 uid
RUN groupadd -r nodeagent && useradd -r -g nodeagent -u 10001 nodeagent \
    && mkdir -p /data/downloads /app/data \
    && chown -R nodeagent:nodeagent /data /app
USER nodeagent

VOLUME ["/data/downloads"]
EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--"]
# HTTP 在 0.0.0.0:8000（通过 $API_HOST/$API_PORT 覆盖）
CMD ["sh", "-c", "uvicorn main:app --host ${API_HOST:-0.0.0.0} --port ${API_PORT:-8000} --forwarded-allow-ips='*' --proxy-headers"]
