# ---- Node Identity ----
NODE_ID=dev-local-01
NODE_NAME=Dev Local 01
REGION=DEV
VERSION=1.0.0

# ---- Optional: Center 注册（留空则不注册，Node 可独立运行）----
# CENTER_URL=https://center.example.com
# NODE_TOKEN=node-token-from-center-admin

# ---- Database ----
DB_URL=sqlite+aiosqlite:///./tasks.db

# ---- Aria2 RPC ----
ARIA2_RPC_URL=http://127.0.0.1:6800/rpc
ARIA2_RPC_SECRET=replace_with_a_long_random_secret_change_me

# ---- Storage ----
DOWNLOAD_DIR=./data/downloads
STORAGE_LIMIT_GB=10            # 本地开发调小，生产 40
MAX_FILE_SIZE_GB=2             # 本地开发调小，生产 10

# ---- Concurrency ----
CONCURRENT_LIMIT=2

# ---- TTL ----
TTL_MINUTES=2                   # 本地开发调小（2 分钟方便测清理），生产 60

# ---- Server ----
API_HOST=0.0.0.0                # Docker / 对外暴露用 0.0.0.0；裸机本机开发可用 127.0.0.1
API_PORT=8000
